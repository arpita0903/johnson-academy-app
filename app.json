{
  "expo": {
    "name": "Johnson Academy",
    "slug": "johnson-academy-app",
    "version": "1.9.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "johnsoynacademy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "description": "Johnson Academy - Music Education Platform",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.johnsonacademy.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Allow Johnson Academy to use your camera to take a profile photo.",
        "NSPhotoLibraryUsageDescription": "Allow Johnson Academy to access your photos so you can update your profile picture."
      },
      "buildNumber": "45"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.johnsonacademy.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 44
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0",
            "ndkVersion": "27.1.12297006",
            "useLegacyPackaging": false,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/round-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0c1224"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Johnson Academy to access your photos so you can update your profile picture.",
          "cameraPermission": "Allow Johnson Academy to use your camera to take a profile photo."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0c1224",
          "defaultChannel": "default",
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "./plugins/withFmtXcode26Fix"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "abb2b53b-3837-41c4-9791-74053ab4ff6e"
      }
    }
  }
}
