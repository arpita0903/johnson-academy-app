{
  "expo": {
    "name": "Johnson Academy",
    "slug": "johnson-academy-app",
    "version": "0.0.10",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "johnsoynacademy",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "description": "Johnson Academy - Music Education Platform",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.johnsonacademy.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.johnsonacademy.app",
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them with your friends."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "abb2b53b-3837-41c4-9791-74053ab4ff6e"
      }
    }
  }
}
